# ---- Compose and Traefik ----------------------------------------------------
# Public host name Traefik routes to the relay.
RELAY_HOST=relay.example.net
# Name of the external Docker network Traefik is attached to.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Pin a version instead of latest if you like: ghcr.io/symphonic-navigator/ollama-relay:v0.1.0
RELAY_IMAGE=ghcr.io/symphonic-navigator/ollama-relay:latest

# ---- MongoDB ------------------------------------------------------------------
# Root credentials, used by the mongo container on first start.
MONGO_ROOT_USERNAME=relay
MONGO_ROOT_PASSWORD=change-me-long-random
# Connection string the relay uses. Repeat the credentials from above.
MONGO_URL=mongodb://relay:change-me-long-random@mongo:27017/?authSource=admin
MONGO_DATABASE=ollama_relay

# ---- Relay --------------------------------------------------------------------
# Public base URL, used in invite links and in the "how to connect" box.
PUBLIC_BASE_URL=https://relay.example.net
# Signs the 15 minute web session tokens. At least 32 characters: openssl rand -base64 48
JWT_SIGNING_KEY=
# First admin, created on first start only if no admin exists. Password change is forced at first login.
ADMIN_USERNAME=chris
ADMIN_INITIAL_PASSWORD=
# The relay sits behind Traefik on a private Docker network: take the client IP from X-Forwarded-For.
TRUST_FORWARDED_HEADERS=true

# ---- Optional tuning (defaults shown) ------------------------------------------
# STRIP_KEEP_ALIVE=true            # drop keep_alive from user requests so nobody pins a model forever
# MAX_REQUEST_BODY_MB=32           # multimodal requests carry images
# QUEUE_TIMEOUT_SECONDS=30         # wait for a free node slot, then 503 with Retry-After
# QUEUE_MAX_LENGTH=64
# USER_MAX_CONCURRENT_STREAMS=4    # per user, abuse protection
# STREAM_IDLE_TIMEOUT_SECONDS=600  # no byte from the node for this long ends the stream (includes model load)
# STREAM_TOTAL_TIMEOUT_SECONDS=7200
# STREAM_BUFFER_KB=8192            # per-stream buffer before a slow client's stream is cancelled
# CORS_ALLOWED_ORIGINS=            # comma separated; CORS on /api and /v1 is off by default
# NODE_HEARTBEAT_SECONDS=5
# NODE_OFFLINE_AFTER_SECONDS=20

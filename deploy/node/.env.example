# Relay WebSocket endpoint. The bare relay URL works too: wss://relay.example.net
RELAY_URL=wss://relay.example.net/node/connect
# Node token from the relay's admin UI (Nodes, Add a node). Shown once.
NODE_TOKEN=orn_
# Where Ollama listens. With host networking this is the default.
OLLAMA_URL=http://127.0.0.1:11434

# Development only: allow plain ws:// to a local relay.
# RELAY_ALLOW_INSECURE=true
